<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Blog</title>
    <link rel="stylesheet" href="/blog.css">
</head>
<body>
    
    <div class="container">
        <button onclick="window.location.href='/cadastrar_post.html'">Cria Post</button>


        <% listaPost.forEach(function (p) { %>
            <div class="post">
                <h3> <%= p.titulo %> </h3>
                <p> <%= p.resumo %> </p>
                <p> <%= p.conteudo %> </p>
            </div>
        <% }) %>
    </div>

</body>
</html>